{
  // Template for an office's settings. Copy to appsettings.<Office>.json (e.g. appsettings.Work.json, which git
  // ignores), add a launch profile with ASPNETCORE_ENVIRONMENT=<Office>, and fill in the token.
  "Urls": "http://localhost:5081",
  "Office": {
    "DataDir": "office-data-work",
    "WorkspaceRoots": [ "~/agent-office-work" ]
  },
  "Providers": {
    // From `claude setup-token`. Leave the key out to use the account logged in on this machine instead.
    "ClaudeCli": { "OAuthToken": "" }
  },
  // Optional: this office's own Telegram bot.
  "Telegram": { "BotToken": "" }
}
