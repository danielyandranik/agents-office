{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",

  "Office": {
    "DataDir": "office-data",
    "WorkspaceRoots": [ "~/agent-office-workspaces" ],
    "MaxStepsPerTurn": 24,
    "MaxDelegationDepth": 2,
    "ShellTimeoutSeconds": 120,
    "MaxToolOutputChars": 12000
  },

  "Providers": {
    "Default": "claude-cli",
    "DefaultModel": "",
    "ClaudeCli": {
      "Command": "claude",
      "Model": "sonnet",
      "Models": [ "opus", "sonnet", "haiku" ]
    },
    "Anthropic": {
      "Model": "claude-sonnet-5-5",
      "MaxOutputTokens": 8192,
      "Models": [ "claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5" ]
    },
    "OpenAI": {
      "Endpoint": "",
      "Model": "gpt-5.4-mini",
      "Models": []
    },
    "Ollama": {
      "Endpoint": "",
      "Model": "qwen3",
      "Models": []
    }
  }
}
