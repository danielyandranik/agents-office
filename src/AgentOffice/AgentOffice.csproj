<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentOffice</RootNamespace>
    <UserSecretsId>agent-office-6f1d2c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework (GA 1.x) -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.*" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.*" />

    <!-- Model providers, all exposed as Microsoft.Extensions.AI IChatClient -->
    <PackageReference Include="Anthropic" Version="13.*" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Data\roles.json" />
    <Content Include="Data\roles.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Data\skills\**" />
    <Content Include="Data\skills\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="office-data\**" />
  </ItemGroup>

</Project>
